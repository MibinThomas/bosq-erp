// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  department    String?
  designation   String?
  signature     String?
  role          String    @default("SALES_EXECUTIVE") // Roles: ADMIN, SALES_MANAGER, SALES_EXECUTIVE, ACCOUNTS, PRODUCTION, ESTIMATOR
  isActive      Boolean   @default(true)
  employeeId    String?
  territories   String?
  status        String    @default("Active")
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  quotations    Quotation[]
  activities    ActivityLog[]
  boqs          Boq[]
  estimatedBoqs Boq[]     @relation("EstimatorBoqs")
  notifications Notification[]
  permissionOverrides UserPermissionOverride[]
  accessLogs           AccessControlLog[]         @relation("OperatorLogs")
  targetAccessLogs     AccessControlLog[]         @relation("TargetUserLogs")

  clientAssignments    ClientAssignment[]         @relation("ClientAssignments")
  quotationAssignments QuotationAssignment[]      @relation("QuotationAssignments")
  accessRequests       ClientAccessRequest[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   // E.g., CLIENT_APPROVAL, QUOTATION_UPDATE, PO_UPDATE, SYSTEM
  isRead    Boolean  @default(false)
  link      String?  // Optional URL to navigate to when clicked
  createdAt DateTime @default(now())
}

model Client {
  id              String      @id @default(cuid())
  clientId        String      @unique // E.g., C-1001
  companyName     String
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  trn             String?
  clientType      String?     @default("Project") // Category: Dealer, Interior, Project, Special
  priceCategory   String?     // P PRICE, D PRICE, I PRICE
  salespersonId   String?
  sharepointFolder String?
  notes           String?
  status          String      @default("Approved")
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  quotations      Quotation[]
  boqs            Boq[]
  assignments     ClientAssignment[]
  documents       ClientDocument[]
  accessRequests  ClientAccessRequest[]
}

model ClientDocument {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title          String   // e.g. "VAT Certificate"
  documentType   String   // e.g. "VAT_CERTIFICATE", "TRADE_LICENSE", "COMPANY_PROFILE", "CUSTOM"
  sharepointUrl  String?
  sharepointId   String?
  fileExtension  String
  fileSize       Int
  uploadedBy     String
  uploadedByName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id              String    @id @default(cuid())
  productCode     String    @unique
  productName     String
  categoryId      String
  category        ProductCategory @relation(fields: [categoryId], references: [id])
  description     String?
  specifications  String?
  imageUrl        String?
  imageUrls       String[]  @default([])
  
  // Category-specific fields
  chairType       String?
  tableTopFinish  String?
  legType         String?
  storageOptions  String?
  finishMaterial  String?
  
  unitPrice       Float     @default(0.0)
  costPrice       Float     @default(0.0)
  interiorPrice   Float     @default(0.0)
  dealerPrice     Float     @default(0.0)
  projectPrice    Float     @default(0.0)
  specialPrice    Float     @default(0.0)
  warranty        String?
  availableColors String?
  dimensions      String?
  stock           Int       @default(0)
  status          String    @default("ACTIVE") // ACTIVE, DISCONTINUED
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  quotationItems  QuotationItem[]
  boqItems        BoqItem[]
}

model Quotation {
  id              String    @id @default(cuid())
  quotationNumber String    @unique // E.g., I1951
  customerSegment String    @default("Project") // Dealer, Interior, Project, Special
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  projectId       String?
  projectName     String?
  date            DateTime  @default(now())
  validityDate    DateTime
  preparedById    String
  preparedBy      User      @relation(fields: [preparedById], references: [id])
  deliveryDate    DateTime?
  paymentTerms    String?
  status          String    @default("DRAFT") // QuoteStatus: DRAFT, SENT, FOLLOW_UP, APPROVED, REJECTED, REVISED, PO_RECEIVED, CANCELLED
  revisionNumber  Int       @default(0) // 0 means original, 1 means I1951-1
  poStatus        String?   @default("PENDING") // PENDING, RECEIVED
  paymentStatus   String?   @default("UNPAID") // UNPAID, PARTIAL, PAID
  followUpDate    DateTime?
  subtotal        Float     @default(0.0)
  discount        Float     @default(0.0)
  deliveryCharge  Float     @default(0.0)
  vatAmount       Float     @default(0.0)
  grandTotal      Float     @default(0.0)
  termsConditions String?
  notes           String?
  sharepointUrl   String?
  
  specialDiscountType   String?   // "PERCENTAGE" | "FIXED"
  specialDiscountValue  Float?    @default(0.0)
  specialDiscountReason String?
  vatMode               String    @default("EXCLUDING") // "EXCLUDING" | "INCLUDING"
  additionalCharges     Json?     // array of { name: string, amount: number }
  
  salesAgentId             String?
  salesAgentName           String?
  salesAgentContactNumber  String?

  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  boqId           String?
  boq             Boq?      @relation(fields: [boqId], references: [id])

  parentId        String?
  parent          Quotation?       @relation("QuotationRevisions", fields: [parentId], references: [id], onDelete: Cascade)
  revisionsList   Quotation[]      @relation("QuotationRevisions")

  items           QuotationItem[]
  revisions       QuotationRevision[]
  assignments     QuotationAssignment[]

  @@index([clientId])
  @@index([preparedById])
  @@index([parentId])
  @@index([boqId])
}

model QuotationItem {
  id              String    @id @default(cuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?  @relation(fields: [productId], references: [id])
  itemNo          Int
  description     String
  specifications  String?
  productNotes    String?
  customImageUrl  String?
  productDescription String?
  categoryName       String?
  chairType          String?
  batchHeading       String?
  quantity        Int       @default(1)
  basePrice       Float     @default(0.0) // Locked segment price set by SALES_MANAGER/ADMIN
  unitPrice       Float     @default(0.0)
  discount        Float     @default(0.0)
  margin          Float     @default(0.0)
  amount          Float     @default(0.0) // (unitPrice - discount) * quantity
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([sortOrder])
}

model QuotationRevision {
  id              String    @id @default(cuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revisionNumber  Int
  revisionDate    DateTime  @default(now())
  previousTotal   Float
  newTotal        Float
  notes           String?
  createdAt       DateTime  @default(now())
}

model PaymentTerm {
  id          String    @id @default(cuid())
  name        String    @unique // E.g., "50% Advance, 50% on Delivery"
  description String?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TermsCondition {
  id          String    @id @default(cuid())
  title       String    @unique
  content     String
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SharePointFile {
  id              String    @id @default(cuid())
  entityType      String    // "QUOTATION", "CLIENT"
  entityId        String
  fileName        String
  fileUrl         String
  sharepointId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ActivityLog {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  action      String    // E.g., "CREATED_QUOTATION", "UPDATED_CLIENT"
  entityType  String
  entityId    String
  details     String?
  createdAt   DateTime  @default(now())
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Boq {
  id              String    @id @default(cuid())
  boqNumber       String    @unique // E.g. BOQ-1001
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  projectId       String?
  projectName     String?
  
  customerSegment String    @default("Project") // Dealer, Interior, Project, Special
  
  preparedById    String
  preparedBy      User      @relation(fields: [preparedById], references: [id])
  
  estimatorId     String?
  estimator       User?     @relation("EstimatorBoqs", fields: [estimatorId], references: [id])
  
  status          String    @default("DRAFT") // DRAFT, SENT_TO_ESTIMATOR, COSTING_COMPLETED, REJECTED, CONVERTED
  
  totalMaterialCost Float   @default(0.0)
  totalLaborCost    Float   @default(0.0)
  totalInstallation Float   @default(0.0)
  totalTransport    Float   @default(0.0)
  totalOverhead     Float   @default(0.0)
  totalCost         Float   @default(0.0)
  
  marginAmount      Float   @default(0.0)
  totalSellingPrice Float   @default(0.0)
  
  isTemplate        Boolean @default(false)
  notes             String?
  termsConditions   String?
  sharepointUrl     String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  items           BoqItem[]
  quotations      Quotation[]

  @@index([clientId])
  @@index([preparedById])
  @@index([estimatorId])
}

model BoqItem {
  id              String    @id @default(cuid())
  boqId           String
  boq             Boq       @relation(fields: [boqId], references: [id], onDelete: Cascade)
  
  productId       String?
  product         Product?  @relation(fields: [productId], references: [id])
  
  itemNo          Int
  description     String
  specifications  String?
  dimensions      String?
  customImageUrl  String?
  
  quantity        Int       @default(1)
  unit            String    @default("Nos") // Nos, Sqft, Lm, etc.
  
  materialCost    Float     @default(0.0)
  laborCost       Float     @default(0.0)
  installationCost Float    @default(0.0)
  transportCost   Float     @default(0.0)
  overheadCost    Float     @default(0.0)
  
  unitCost        Float     @default(0.0)
  totalCost       Float     @default(0.0)
  
  marginPercentage Float    @default(0.0)
  unitSellingPrice Float    @default(0.0)
  totalSellingPrice Float   @default(0.0)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id                 String   @id @default(cuid())
  roleId             String
  role               Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module             String   // e.g. "DASHBOARD", "QUOTATIONS", "PRODUCTS"
  view               Boolean  @default(false)
  create             Boolean  @default(false)
  edit               Boolean  @default(false)
  delete             Boolean  @default(false)
  approve            Boolean  @default(false)
  reject             Boolean  @default(false)
  export             Boolean  @default(false)
  downloadPdf        Boolean  @default(false)
  uploadFiles        Boolean  @default(false)
  share              Boolean  @default(false)
  manage             Boolean  @default(false)
  ownership          String   @default("ALL") // "OWN", "DEPARTMENT", "ASSIGNED", "ALL"
  approvalLimit      Float?   // AED limit
  costPriceVisible   Boolean  @default(false)
  dealerPriceVisible  Boolean  @default(false)
  marginVisible      Boolean  @default(false)
  profitVisible      Boolean  @default(false)
  markupVisible      Boolean  @default(false)
  maxDiscountPercent  Float?   @default(0.0)
  canOverrideVat      Boolean  @default(false)
  canAddCustomCharges Boolean  @default(false)
  canConfirmQuotation Boolean  @default(false)
  canApplySpecialDiscount Boolean @default(false)
}

model UserPermissionOverride {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module        String
  action        String   // "view", "create", "edit", "delete", "approve", "costPriceVisible", etc.
  value         Boolean  // true = force grant, false = force deny
  ownership     String?
  approvalLimit Float?
  
  maxDiscountPercent  Float?   @default(0.0)
  canOverrideVat      Boolean  @default(false)
  canAddCustomCharges Boolean  @default(false)
  canConfirmQuotation Boolean  @default(false)
  canApplySpecialDiscount Boolean @default(false)

  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, module, action])
}

model AccessControlLog {
  id           String   @id @default(cuid())
  userId       String   // Operator
  user         User     @relation("OperatorLogs", fields: [userId], references: [id])
  targetUserId String?  // Target User (if applicable)
  targetUser   User?    @relation("TargetUserLogs", fields: [targetUserId], references: [id])
  targetRoleId String?  // Target Role (if applicable)
  action       String   // E.g., "UPDATE_ROLE_PERMISSION"
  details      String
  createdAt    DateTime @default(now())
}

model ClientAssignment {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ClientAssignments", fields: [userId], references: [id], onDelete: Cascade)
  
  isPrimary           Boolean @default(false)
  allowAllQuotations  Boolean @default(true) // If false, check QuotationAssignment
  allowQuotationEdit  Boolean @default(false)
  allowRevisionApproval Boolean @default(false)
  allowBoqAccess      Boolean @default(false)
  allowPricingVisibility Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([clientId, userId])
  @@index([userId])
  @@index([clientId])
}

model QuotationAssignment {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("QuotationAssignments", fields: [userId], references: [id], onDelete: Cascade)
  
  allowEdit              Boolean @default(false)
  allowRevisionApproval  Boolean @default(false)
  allowPricingVisibility Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([quotationId, userId])
}

model ClientAccessRequest {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName        String
  status          String   @default("Requested") // Requested | Approved | Rejected
  notes           String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clientId, userId])
}

model SequenceTracker {
  id          String   @id @default(cuid())
  type        String   @unique // e.g., "CLIENT_D", "CLIENT_P", "CLIENT_I", "QUOTE_I"
  lastValue   Int      @default(0)
  prefix      String?
  description String?
  updatedAt   DateTime @updatedAt
}
